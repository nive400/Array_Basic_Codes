import java.util.*;
Class Main{
public static void main(String [] args){
Scanner sc=new Scanner(System.in);
int size=sc.nextInt();
int[] arr=new int[size];
for(int i=0;i<size;i++){
arr[i]=sc.nextInt();
}
int key=sc.nextInt();
int p=-1;
for(int i=0;i<size;i++){
if(arr[i]==key)
{
p=i;
}
}
if(p!=-1){
System.out.Print("Element Found at"+p);
}
else
{
System.out.Print("Element not found");
}
}
}
