import java.util.*;
Class Main{
public static void main(String [] args){
Scanner sc=new Scanner(System.in);
int size=sc.nextInt();
int[] arr=new int[size];
for(int i=0;i<size;i++){
arr[i]=sc.nextInt();
}
int l=0;
int r=size;
int target=sc.nextInt();
while(l<r)
{
int m=l+(r-l)/2;
if(arr[m]==target){
System.out.Print("Element Found at"+m);
}
elseif(arr[m]<target){
l=m+1;
}
else{
r=m-1;
}
}
System.out.Print("Element not found");
}
}
